# Rename this file to `.env.local` in development and provide real values.
# Database connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/plately?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe keys (publishable keys are exposed to the client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# App domain for multi‑tenant middleware
NEXT_PUBLIC_APP_DOMAIN="plately.us"
# Internal API token for domain lookup (optional)
INTERNAL_API_URL=""
INTERNAL_API_TOKEN=""